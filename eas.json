{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825141675",
        "ascApiKeyPath": "$EXPO_ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "$EXPO_ASC_ISSUER_ID",
        "ascApiKeyId": "$EXPO_ASC_KEY_ID"
      },
      "android": {
        "serviceAccountKeyPath": "$GOOGLE_SERVICE_ACCOUNT_KEY_PATH",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
