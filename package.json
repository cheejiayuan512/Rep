{
  "name": "rep",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/ui": "~58.0.25",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@react-navigation/stack": "^7.12.1",
    "@reduxjs/toolkit": "^2.13.0",
    "expo": "~58.0.21",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-haptics": "~58.0.7",
    "expo-notifications": "~58.1.7",
    "expo-sharing": "~58.0.21",
    "expo-status-bar": "~58.0.4",
    "expo-widgets": "~58.0.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.2",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx src/domain/run-tests.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "test:e2e": "playwright test",
    "seed:demo": "tsx scripts/seed-demo-log.ts",
    "assets": "tsx scripts/store-assets.ts",
    "assets:force": "tsx scripts/store-assets.ts --force",
    "assets:if-changed": "tsx scripts/store-assets.ts --if-changed",
    "copy": "tsx scripts/store-copy.ts",
    "copy:write": "tsx scripts/store-copy.ts --write",
    "art": "tsx scripts/store-art.ts",
    "art:force": "tsx scripts/store-art.ts --redraw",
    "video": "tsx scripts/store-video.ts",
    "upload": "tsx scripts/store-upload.ts",
    "upload:apply": "tsx scripts/store-upload.ts --apply",
    "upload:if-changed": "tsx scripts/store-upload.ts --apply --if-changed",
    "release": "npx eas-cli@latest build --platform all --profile production --auto-submit",
    "release:ios": "npx eas-cli@latest build --platform ios --profile production --auto-submit",
    "release:android": "npx eas-cli@latest build --platform android --profile production --auto-submit"
  },
  "private": true
}
