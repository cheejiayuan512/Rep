{
  "expo": {
    "name": "Rep",
    "slug": "Rep",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0F14",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cheejiayuan.rep",
      "appleTeamId": "ZC96W3Y7JU",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      }
    },
    "android": {
      "package": "com.cheejiayuan.rep",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#0C0F14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/without-push-entitlement.js",
      [
        "expo-notifications",
        {
          "color": "#D6FF4A"
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.cheejiayuan.rep.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.cheejiayuan.rep",
          "enableAndroid": true,
          "widgets": [
            {
              "name": "RepWidget",
              "displayName": "Rep",
              "description": "This week's workouts, volume, and streak",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/components/home-widget.ios.tsx"
              },
              "android": {
                "initialLayout": "./src/components/home-widget.android.tsx",
                "minWidth": 180,
                "minHeight": 110,
                "targetCellWidth": 4,
                "targetCellHeight": 2
              }
            }
          ]
        }
      ],
      "expo-status-bar",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "59e0c5e1-67ce-4904-9e10-d1eaf43b4592"
      }
    }
  }
}
